#!/usr/bin/env python3
"""Check this machine against memory/config.md: base binaries, broken tool links, and what each switch set to yes needs.
Usage: verificar-ambiente [--self-check]. One line per check; the last line is the summary. Installs nothing."""
import datetime, shutil, subprocess, sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parents[2]
FERR = RAIZ / "ferramentas"


def config():
    for pasta in ("memory", "memoria"):
        f = RAIZ / pasta / "config.md"
        if f.exists():
            return dict((k.strip(), v.strip()) for k, _, v in (l.partition(":") for l in f.read_text().splitlines() if ":" in l and not l.startswith("#")))
    return {}


MIN_LIVRE_GB = 30   # whisperx alone downloads ~4.4 GB; video grows fast


def livre_gb():
    return shutil.disk_usage(RAIZ).free / 1e9


def ytdlp_recente():
    """yt-dlp versions are dates (2026.10.01). An old one is refused by YouTube, so older than 90 days counts as missing."""
    exe = shutil.which("yt-dlp") or str(Path.home() / ".local/bin/yt-dlp")
    try:
        v = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=20).stdout.strip()
        return (datetime.date.today() - datetime.datetime.strptime(v[:10], "%Y.%m.%d").date()).days <= 90
    except Exception:
        return False


def navegador_da_ferramenta(venv_python):
    """Real test: does the browser build this tool's patchright expects exist on disk? A bare import proves nothing."""
    code = "from patchright.sync_api import sync_playwright as s\np=s().start()\nimport os,sys\nsys.exit(0 if os.path.exists(p.chromium.executable_path) else 1)"
    try:
        return subprocess.run([str(venv_python), "-c", code], capture_output=True, timeout=60).returncode == 0
    except Exception:
        return False


def checks(c):
    out = [(f"binary {b}", bool(shutil.which(b))) for b in ("python3", "git", "ffmpeg", "node")]
    out += [(f"broken link ferramentas/{p.name}", False) for p in FERR.iterdir() if p.is_symlink() and not p.exists()]
    out.append((f"free disk {livre_gb():.0f} GB (want {MIN_LIVRE_GB}+)", livre_gb() >= MIN_LIVRE_GB))
    if c.get("status") != "ready" or c.get("existing_content") == "yes" or c.get("instagram_research") == "yes":
        out.append(("yt-dlp present and under 90 days old", ytdlp_recente()))
    out.append(("Pytho-inator cloned", (FERR / "Pytho-inator" / "pytho-inator").exists()))
    yes = lambda k: c.get(k) in ("yes", "manual", "auto", "whisper", "elevenlabs")
    if c.get("transcription") == "whisper":
        out.append(("transcrever venv", (FERR / "transcrever" / "venv").exists()))
    if c.get("transcription") == "elevenlabs":
        import os
        out.append(("ELEVENLABS_API_KEY set", bool(os.environ.get("ELEVENLABS_API_KEY"))))
    if c.get("last30days") == "yes":
        out.append(("last30days-skill cloned", (FERR / "last30days-skill").exists()))
    if c.get("grok_image") == "yes":
        out.append(("grok CLI on PATH", bool(shutil.which("grok"))))
    if c.get("reddit") in ("manual", "auto"):
        out.append(("reddit-answers present", (FERR / "reddit-answers" / "reddit-answers").exists()))
        py = FERR / "scrapling" / ".venv" / "bin" / "python"
        out.append(("reddit-answers browser build matches patchright", py.exists() and navegador_da_ferramenta(py)))
    if c.get("face") == "yes":
        out.append(("video-camadas present", (FERR / "video-camadas").exists()))
    if c.get("claude_in_chrome") == "yes":
        out.append(("Claude in Chrome: ask the agent to open a test tab", True))
    return out


def main():
    c = config()
    if not c:
        print("no memory/config.md found")
        return 1
    res = checks(c)
    for nome, ok in res:
        print(f"{'ok   ' if ok else 'FALTA'} {nome}")
    faltam = [n for n, ok in res if not ok]
    print(f"resumo: {len(res) - len(faltam)} ok, {len(faltam)} missing" + (f" ({'; '.join(faltam)})" if faltam else ""))
    return 1 if faltam else 0


def self_check():
    r = checks({"transcription": "whisper", "face": "yes", "reddit": "no"})
    assert any(n == "binary python3" and ok for n, ok in r) and any(n == "video-camadas present" for n, _ in r)
    assert not any("grok" in n for n, _ in r)
    assert any(n.startswith("free disk") for n, _ in r)
    print("self-check ok")


if __name__ == "__main__":
    self_check() if sys.argv[1:] == ["--self-check"] else sys.exit(main())
