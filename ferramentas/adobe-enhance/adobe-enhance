#!/usr/bin/env python3
"""Adobe Podcast Enhance no layout raw/ -> edit/ deste projeto.
O trabalho é do repo público clonado em ferramentas/adobe-podcast/ (enhance.py);
aqui só se escolhe pastas e o venv do Scrapling (já tem patchright + chromium).

  adobe-enhance login                       1x: loga no Adobe na janela (sessão em .profile/, gitignored)
  adobe-enhance run <pasta-do-tema> [--show] raw/*.mp4 -> edit/audio/<stem>-enhanced.mp3 + edit/<stem>-enhanced.mp4
Fallback manual (UI do Adobe mudou): ferramentas/adobe-podcast/skills/adobe-podcast-enhance/SKILL.md.
"""
import json, os, pathlib, shutil, subprocess, sys

AQUI = pathlib.Path(__file__).resolve().parent
ENHANCE = AQUI.parent / "adobe-podcast" / "enhance.py"
PY = AQUI.parent / "scrapling" / ".venv" / "bin" / "python"
ENV = os.environ | {"ADOBE_PROFILE": str(AQUI / ".profile")}


def enhance(*args):
    if subprocess.run([str(PY), str(ENHANCE), *map(str, args)], env=ENV).returncode:
        sys.exit(f"falhou: enhance.py {' '.join(map(str, args[:2]))}")


def run(tema, show):
    tema = pathlib.Path(tema).resolve()
    audio, trabalho = tema / "edit" / "audio", tema / "edit" / "adobe"
    raws = sorted((tema / "raw").glob("*.mp4"))
    if not raws:
        sys.exit(f"sem raw/*.mp4 em {tema}")
    for raw in raws:
        destino = audio / f"{raw.stem}-enhanced.mp3"
        if destino.exists():
            print(f"{raw.stem}: já feito, pulando"); continue
        work = trabalho / raw.stem
        if not (work / "manifest.json").exists():
            enhance("prepare", raw, "--out", trabalho, "--max-mb", "0")
        enhance("upload", work, *(["--show"] if show else []))
        enhance("replace", work, "--out-dir", tema / "edit", "--force")
        limpo = work / json.loads((work / "manifest.json").read_text())["clean_audio"]
        audio.mkdir(parents=True, exist_ok=True)
        # ponytail: gravação >29 min vira várias partes e o limpo é .flac; aí o nome sai -enhanced.flac
        shutil.copy2(limpo, destino.with_suffix(limpo.suffix))
        print(f"{raw.stem}: ok -> edit/audio/{destino.with_suffix(limpo.suffix).name}, edit/{raw.stem}-enhanced.mp4")


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["login"] and len(a) == 1:
        enhance("login")
    elif a[:1] == ["run"] and len(a) in (2, 3) and a[2:] in ([], ["--show"]):
        run(a[1], a[2:] == ["--show"])
    else:
        sys.exit(__doc__)
