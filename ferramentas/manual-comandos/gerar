def fm(path):
    t = path.read_text()
    m = re.match(r"---\n(.*?)\n---", t, re.S)
    d = {}
    for line in (m.group(1).split("\n") if m else []):
        k, _, v = line.partition(":")
        if _:
            d[k.strip()] = v.strip().strip("'\"")
    return d

def curto(s, n=120):
    s = re.split(r"\. ", s)[0]
    if len(s) <= n:
        return s
    return s[: n - 1].rsplit(" ", 1)[0].rstrip(" ,;:(—") + "…"

linhas = ["# Commands and skills", "",
          "> Generated by `ferramentas/manual-comandos/gerar`. Do not edit this file by hand.", "",
          "## Commands", "", "| Command | What it does | When | Argument |", "|---|---|---|---|"]
for p in sorted((RAIZ / ".claude/commands").glob("*.md")):
    d = fm(p)
    n = p.stem
    arg = d.get("argument-hint", "").replace("|", "/") or "—"
    linhas.append(f"| `/{n}` | {curto(d.get('description', ''))} | {USO.get(n, '(no usage note)')} | {curto(arg, 70)} |")
linhas += ["", "## Skills", "", "| Skill | What it is for |", "|---|---|"]
for p in sorted((RAIZ / ".claude/skills").glob("*/SKILL.md")):
    d = fm(p)
    linhas.append(f"| `{d.get('name', p.parent.name)}` | {curto(d.get('description', ''), 150)} |")
linhas += ["", "Each command is `.claude/commands/<name>.md`.", ""]
(RAIZ / "COMANDOS.md").write_text("\n".join(linhas))
print(f"COMANDOS.md updated: {len(list((RAIZ / '.claude/commands').glob('*.md')))} commands")


# ---- Tool catalog: one row per folder in ferramentas/, written into a skill so every agent finds the tools ----
FERR = RAIZ / "ferramentas"
SKIP = {"_repos", "_old"}


def tabela_repo(pasta):
    """Rows `| name | what it does |` from the README of the repo that holds this tool."""
    r = pasta.resolve().parent / "README.md"
    out = {}
    for l in (r.read_text().splitlines() if r.exists() else []):
        c = [x.strip(" `") for x in l.strip().strip("|").split("|")]
        if l.startswith("|") and len(c) >= 2 and not set(c[0]) <= set("-: "):
            out[c[0]] = c[1]
    return out


def principal(pasta):
    for nome in (pasta.name, pasta.name.replace("-", "_") + ".py", pasta.name + ".py"):
        if (pasta / nome).is_file():
            return nome
    for e in ("*.py", "*.sh"):
        for f in sorted(pasta.glob(e)):
            return f.name
    return ""


def docstring(f):
    t = f.read_text(errors="ignore")
    m = re.search(r'^\s*(?:#!.*\n)?\s*(?:"""|\'\'\')(.+?)(?:"""|\'\'\')', t, re.S) or re.search(r"^#!.*\n#\s*(.+)", t)
    return re.split(r"\. |\n", m.group(1).strip())[0] if m else ""


