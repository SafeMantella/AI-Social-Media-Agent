def descricao(pasta):
    if pasta.name in DESC:
        return DESC[pasta.name]
    rd = pasta / "README.md"
    if rd.exists():
        for l in rd.read_text().splitlines():
            l = l.strip()
            if l and not l.startswith(("#", "|", "```", ">", "-", "<")):
                return curto(l, 160)
    t = tabela_repo(pasta).get(pasta.name)
    if t:
        return curto(t, 160)
    m = principal(pasta)
    d = docstring(pasta / m) if m else ""
    return curto(d, 160) if d else "(no description yet: add a one-line README.md in the tool folder)"


def origem(pasta):
    if pasta.is_symlink():
        return pasta.resolve().relative_to(FERR.resolve()).parts[1] if "_repos" in pasta.resolve().parts else "link"
    if (pasta / ".git").exists():
        r = subprocess.run(["git", "-C", str(pasta), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
        return r.removesuffix(".git").split("github.com/")[-1] or "local clone"
    return "tracked here"


cat = ["---", "name: catalogo-ferramentas",
       "description: Catalog of every tool in ferramentas/, one folder each, with what it does, how to run it, and where its code lives. Generated. Use to find the right local tool before writing a script, or when the creator asks what tools exist.",
       "---", "", "# Tool catalog", "",
       "> Generated by `ferramentas/manual-comandos/gerar`. Do not edit by hand. Add a tool by creating `ferramentas/<name>/` with a one-line `README.md`, then run the generator (or `/comandos`).", "",
       "Every path below is under `ferramentas/`. Syntax, gotchas, and config switches for each tool are in `.claude/skills/ferramentas-locais/SKILL.md` and in the tool's own README. Check `memory/config.md` before running a tool that needs an account.", "",
       "| Tool | What it does | Entry | Code lives in | Skill |", "|---|---|---|---|---|"]
sem_desc = []
for p in sorted(FERR.iterdir(), key=lambda x: x.name.lower()):
    if not p.is_dir() or p.name in SKIP or p.name.startswith("."):
        continue
    d = descricao(p)
    if d.startswith("(no description"):
        sem_desc.append(p.name)
    m = principal(p)
    sk = f"`{p.name}`" if (RAIZ / ".claude/skills" / p.name / "SKILL.md").exists() else "—"
    cat.append(f"| `{p.name}/` | {d.replace('|', '/')} | {('`' + m + '`') if m else '—'} | {origem(p)} | {sk} |")
faltam = [(n, u, w) for n, (u, w) in OPCIONAIS.items() if not (FERR / n).exists()]
if faltam:
    cat += ["", "## Not cloned on this machine", "", "Clone one only when a task needs it, with the creator's yes (`cd ferramentas && git clone <url>`).", "", "| Folder | Clone | Used for |", "|---|---|---|"]
    cat += [f"| `{n}/` | `{u}` | {w} |" for n, u, w in faltam]
cat.append("")
(RAIZ / ".claude/skills/catalogo-ferramentas").mkdir(exist_ok=True)
(RAIZ / ".claude/skills/catalogo-ferramentas/SKILL.md").write_text("\n".join(cat))
print(f"catalogo-ferramentas updated: {sum(1 for l in cat if l.startswith('| `') and '/` |' in l.split('|')[1] + '|') - len(faltam)} tools" + (f"; no description: {', '.join(sem_desc)}" if sem_desc else ""))

# ---- Pointer check: every ferramentas/<name> mentioned in agent files must exist ----
ref = re.compile(r"ferramentas/([A-Za-z0-9_.-]+)")
quebrados = {}
for base in (RAIZ / ".claude", RAIZ / "memory", RAIZ / "AGENTS.md", RAIZ / "README.md"):
    for f in ([base] if base.is_file() else base.rglob("*.md")):
        if f.parent.name == "catalogo-ferramentas":
            continue
        for n in set(ref.findall(f.read_text(errors="ignore"))):
            if n not in SKIP and n not in OPCIONAIS and n not in ("tiktok-api", "minet", "scrapling") and not n.endswith((".md", ".py")) and not (FERR / n).exists():
                quebrados.setdefault(n, set()).add(str(f.relative_to(RAIZ)))
for n, fs in sorted(quebrados.items()):
    print(f"pointer to missing ferramentas/{n}: {', '.join(sorted(fs))}")
