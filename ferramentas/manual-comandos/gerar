#!/usr/bin/env python3
"""Write COMANDOS.md from the frontmatter of commands and skills. Do not edit COMANDOS.md by hand."""
import pathlib, re

RAIZ = pathlib.Path(__file__).resolve().parents[2]
USO = {
    "aplicar-idioma": "Once, after the onboarding readback.",
    "atualizar-do-git": "When the weekly template pull is due.",
    "atualizar-ferramentas": "When a cloned tool may be behind its remote.",
    "atualizar-memoria": "At the end of a session with decisions that are not saved yet.",
    "avaliar-edicao": "When a raw video needs the manual cut review.",
    "check-skills": "When a skill has steps one local Python CLI could finish.",
    "comandos": "When you need the list of commands.",
    "edicao": "When opening the manual cut-review page.",
    "map-automation-opportunities": "When a repeated workflow is still written as steps.",
    "pesquisar": "Before a new piece, on a subject, a profile, or a work.",
    "refinar-overlay": "When an overlay on a video is colliding or misplaced.",
    "registrar-bastidores": "When behind_the_scenes is yes and the session changed the system.",
    "reportar-evolucao": "When the monthly upstream report is due.",
    "revisar-armazenamento": "When the weekly storage review is due.",
    "revisar-video": "Before giving notes on an edited video.",
    "sugerir-conteudo": "At the end of a working session, for content ideas.",
}

def fm(path):
    t = path.read_text()
    m = re.match(r"---\n(.*?)\n---", t, re.S)
    d = {}
    for line in (m.group(1).split("\n") if m else []):
        k, _, v = line.partition(":")
        if _:
            d[k.strip()] = v.strip().strip("'\"")
    return d

def curto(s, n=120):
    s = re.split(r"\. ", s)[0]
    if len(s) <= n:
        return s
    return s[: n - 1].rsplit(" ", 1)[0].rstrip(" ,;:(—") + "…"

linhas = ["# Commands and skills", "",
          "> Generated by `ferramentas/manual-comandos/gerar`. Do not edit this file by hand.", "",
          "## Commands", "", "| Command | What it does | When | Argument |", "|---|---|---|---|"]
for p in sorted((RAIZ / ".claude/commands").glob("*.md")):
    d = fm(p)
    n = p.stem
    arg = d.get("argument-hint", "").replace("|", "/") or "—"
    linhas.append(f"| `/{n}` | {curto(d.get('description', ''))} | {USO.get(n, '(no usage note)')} | {curto(arg, 70)} |")
linhas += ["", "## Skills", "", "| Skill | What it is for |", "|---|---|"]
for p in sorted((RAIZ / ".claude/skills").glob("*/SKILL.md")):
    d = fm(p)
    linhas.append(f"| `{d.get('name', p.parent.name)}` | {curto(d.get('description', ''), 150)} |")
linhas += ["", "Each command is `.claude/commands/<name>.md`.", ""]
(RAIZ / "COMANDOS.md").write_text("\n".join(linhas))
print(f"COMANDOS.md updated: {len(list((RAIZ / '.claude/commands').glob('*.md')))} commands")
